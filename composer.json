{
    "name": "marketredesign/mrd-auth0-laravel",
    "description": "Wrapper to easily configure Auth0 with a Laravel application",
    "keywords": [
        "marketredesign",
        "mrd-auth0-laravel"
    ],
    "homepage": "https://github.com/marketredesign/mrd-auth0-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Marijn van der Horst",
            "email": "marijn.vander.horst@marketredesign.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "beta",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "facile-it/php-openid-client": "^0.4.0-beta1",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^6.0|^7.0",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "nyholm/psr7": "^1.8",
        "symfony/psr-http-message-bridge": "^v7.1"
    },
    "require-dev": {
        "ext-openssl": "*",
        "laravel/pint": "^1.18",
        "larastan/larastan": "^2.11",
        "orchestra/testbench": "^8.25",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^10.5",
        "psr-mock/http": "^1.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Marketredesign\\MrdAuth0Laravel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marketredesign\\MrdAuth0Laravel\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/phpunit -c phpunit.xml --log-junit test_reports/report.xml"
        ],
        "analyze": [
            "pint --test",
            "phpmd src xml phpmd.xml",
            "phpstan analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marketredesign\\MrdAuth0Laravel\\MrdAuth0LaravelServiceProvider"
            ]
        }
    }
}
